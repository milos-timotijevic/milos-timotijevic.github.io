    {
      "@type": "Book",
      "@id": "https://milos-timotijevic.github.io/books/modernizacija-balkanskog-grada.html#work",
      "name": "Модернизација балканског града (1944–1989): компаративна анализа развоја Чачка и Благоевграда у епохи социјализма",
      "alternateName": [
        "Modernization of the Balkan City (1944–1989): A Comparative Analysis of the Development of Čačak and Blagoevgrad in the Socialist Era",
        "Modernizacija balkanskog grada (1944–1989)"
      ],
      "url": "https://milos-timotijevic.github.io/books/modernizacija-balkanskog-grada.html",
      "mainEntityOfPage": {
        "@id": "https://milos-timotijevic.github.io/books/modernizacija-balkanskog-grada.html#webpage"
      },
      "author": {
        "@id": "https://milos-timotijevic.github.io/#person"
      },
      "description": "Comparative scholarly monograph on socialist modernization in Čačak and Blagoevgrad, examining industrialization, urbanization and social change, with particular attention to local power structures, institutions, urban planning, everyday life and the problem of limited modernity.",
      "abstract": "A comparative case study of two medium-sized Balkan cities under different variants of state socialism. The monograph investigates how inherited structures, state intervention, local actors and institutions shaped industrialization, urbanization and social transformation between 1944 and 1989, and uses the comparison to examine the uneven and limited production of modernity under socialism.",
      "inLanguage": "sr",
      "temporalCoverage": "1944/1989",
      "spatialCoverage": [
