      "@type": "Dataset",
      "name": [
        {
          "@value": "Ентитетски граф — пилотски скуп података",
          "@language": "sr"
        },
        {
          "@value": "Entity Graph — Pilot Dataset",
          "@language": "en"
        }
      ],
      "description": [
        {
          "@value": "Машински читљив JSON-LD извоз личности, установа, места, извора, контролисаних типова односа и проверљивих веза из пилот-корпуса.",
          "@language": "sr"
        },
        {
          "@value": "Machine-readable JSON-LD export of people, institutions, places, sources, controlled relation types and verifiable relations from the pilot corpus.",
          "@language": "en"
        }
      ],
      "url": "https://milos-timotijevic.github.io/knowledge-graph/entities/",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "dateModified": "2026-09-21",
      "version": "0.3",
      "creator": "https://milos-timotijevic.github.io/#person",
